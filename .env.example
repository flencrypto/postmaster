# ── Required secrets — copy this file to .env and fill in values ──────────────
# Used by docker-compose.yml

# PostgreSQL
POSTGRES_DB=threadoptimizer
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password

# Application secrets
JWT_SECRET=change-me-at-least-32-chars-long
ENCRYPTION_KEY=change-me-exactly-32-chars-long!!

# Meta / Threads OAuth
META_APP_ID=
META_APP_SECRET=
# Local Docker:  http://localhost:3001/api/auth/threads/callback
# Vercel:        https://<your-vercel-domain>.vercel.app/api/auth/threads/callback
META_REDIRECT_URI=http://localhost:3001/api/auth/threads/callback

# Grok (xAI)
XAI_API_KEY=

# Unsplash (image suggestions)
UNSPLASH_ACCESS_KEY=

# Frontend URL (used for CORS and OAuth postMessage targetOrigin)
# Local Docker:  http://localhost:3000
# Vercel:        https://<your-vercel-domain>.vercel.app
FRONTEND_URL=http://localhost:3000

# ── Video generation (optional) ───────────────────────────────────────────────
# Provider: runway | pika | kling | luma  (defaults to runway)
VIDEO_GEN_PROVIDER=runway
RUNWAY_API_KEY=
PIKA_API_KEY=
KLING_API_KEY=
LUMA_API_KEY=
ELEVENLABS_API_KEY=
